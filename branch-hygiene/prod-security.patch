+COMPOSE_PROJECT_NAME=uah-dev
+ENV=dev
+DEV_DOMAIN=dev.uahapp.com
+
+# --- Postgres ---
+POSTGRES_USER=uah
+POSTGRES_PASSWORD=
+POSTGRES_DB=uah_dev
+POSTGRES_PORT=5432
+
+# --- Security (generate with: python -c "import secrets; print(secrets.token_hex(32))") ---
+SECRET_KEY=
+SESSION_SECRET=
+
+# --- API ---
+API_PORT=8000
+API_HOST=0.0.0.0
+
+# --- Vue ---
+VUE_PORT=5173
+
+# --- The Muse Jobs API ---
+MUSE_API_KEY=
+
+# --- Google OAuth ---
+GOOGLE_CLIENT_ID=
+GOOGLE_CLIENT_SECRET=
+GOOGLE_REDIRECT_URI=https://dev.uahapp.com/api/auth/google/callback
+
+# --- Z.AI (Resume OCR + LLM Parsing) ---
+ZAI_API_KEY=
+ZAI_OCR_URL=https://api.z.ai/api/paas/v4/layout_parsing
+ZAI_LLM_URL=https://api.z.ai/api/paas/v4/chat/completions
+ZAI_LLM_MODEL=GLM-4.7-Flash
+
+# --- Email (SMTP) ---
+EMAILS_ENABLED=false
+PUBLIC_APP_URL=https://dev.uahapp.com
+SMTP_HOST=
+SMTP_PORT=587
+SMTP_USE_TLS=true
+SMTP_USE_SSL=false
+SMTP_FROM=UAH <noreply@uahapp.com>
+SMTP_USERNAME=
+SMTP_PASSWORD=
+SMTP_TIMEOUT_SECONDS=20
+
+# --- Geolocation ---
+GEO_IP_PROVIDER=ipapi
+# Optional — only needed when GEO_IP_PROVIDER=ipstack
+IPSTACK_API_KEY=
+GEOLOCATION_AUTO_BUILD_DATASET=true
+GEOLOCATION_DATASET_TIMEOUT_SECONDS=90
+NOMINATIM_USER_AGENT=UAH-JobBoard-Geolocation/1.0
+
+# --- Muse search guardrails ---
+MUSE_PAGE_CHASE_ENABLED=true
+MUSE_PAGE_CHASE_MAX_PAGES=3
+MUSE_PAGE_CHASE_MAX_API_CALLS_PER_REQUEST=3
+MUSE_PAGE_CHASE_TARGET_ACCEPTED_RESULTS=20
+MUSE_PAGE_CHASE_MIN_FILTERED_RATIO=0.4
+MUSE_PAGE_CHASE_TIMEOUT_SECONDS=8
+MUSE_LOCATION_PARAM_CAP=60
+JOBS_DEFAULT_PAGE_SIZE=10
+JOBS_CACHE_ENABLED=true
+JOBS_CACHE_TTL_SECONDS=45
+JOBS_CACHE_MAX_KEYS=250
+
+# --- Muse location index (country selector source) ---
+MUSE_LOCATION_INDEX_ENABLED=true
+MUSE_LOCATION_INDEX_REFRESH_HOURS=24
+MUSE_LOCATION_INDEX_SCAN_MAX_PAGES=25
+MUSE_LOCATION_INDEX_TIMEOUT_SECONDS=10
+MUSE_LOCATION_INDEX_RETENTION_DAYS=45
+
+# --- Dev TLS (VPN-only HTTPS) ---
+DEV_TLS_ENABLED=false
+DEV_TLS_CERT_PATH=/etc/nginx/certs/tls.crt
+DEV_TLS_KEY_PATH=/etc/nginx/certs/tls.key
+
+# --- Admin ---
+ADMIN_BOOTSTRAP_ENABLED=false
+ADMIN_BOOTSTRAP_USERNAME=
+ADMIN_BOOTSTRAP_PASSWORD=
+ADMIN_BOOTSTRAP_FIRST_NAME=
+ADMIN_BOOTSTRAP_LAST_NAME=
