# ===================================================================
# UAH production environment template
# ===================================================================
# This file is intentionally concise and security-focused.
# Copy values into repo-root .env on the production host.
# Do not run production with placeholder_* values.
#
# Runtime reads ./.env at repository root, not this env-examples folder.
# ===================================================================

# --- Core identity and runtime mode ---
# Short env label used by scripts.
ENV=prod
# API metadata.
PROJECT_NAME=UAH
VERSION=0.1.0
# Canonical runtime environment slug.
ENVIRONMENT=production
# Compose naming prefix for production resources.
COMPOSE_PROJECT_NAME=uah-prod

# --- Required secrets and credentials ---
# Database password for production Postgres user.
POSTGRES_PASSWORD=placeholder_prod_postgres_password
# JWT signing secret.
SECRET_KEY=placeholder_prod_secret_key
# Session cookie signing secret (must differ from SECRET_KEY).
SESSION_SECRET=placeholder_prod_session_secret
# Dedicated encryption key for persisted Gmail refresh tokens.
GMAIL_TOKEN_ENCRYPTION_KEY=placeholder_prod_gmail_token_encryption_key

# --- Auth/session isolation and cookie policy ---
# Namespace must be production-specific.
AUTH_NAMESPACE=prod
# HttpOnly browser auth cookie name.
AUTH_COOKIE_NAME=uah_auth_prod
# Cookie name must be production-scoped and not default "session".
SESSION_COOKIE_NAME=uah_session_prod
# SameSite: lax | strict | none
SESSION_COOKIE_SAMESITE=lax
# Cookie path scope.
SESSION_COOKIE_PATH=/
# Production should keep cookies HTTPS-only.
SESSION_COOKIE_HTTPS_ONLY=true
# Default web JWT lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Browser extension auth lifetime in minutes when X-UAH-Client=extension.
EXTENSION_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Safety defaults for prod ---
# Must remain false in production.
DEV_AUTH_TEST_ACCOUNT_ENABLED=false
DEV_AUTH_TEST_IS_DEVELOPER=false
# Frontend auth namespace must match production environment.
VITE_AUTH_NAMESPACE=prod
# Frontend must use backend mode in remote deployments.
VITE_LOCAL_MODE=backend

# --- External provider keys ---
# Job search API key.
MUSE_API_KEY=placeholder_prod_muse_api_key
THE_MUSE_API_KEY=placeholder_prod_muse_api_key
THE_MUSE_RATE_LIMIT_PER_HOUR=1000
ARBEITNOW_INTER_REQUEST_DELAY=3.0
FINDWORK_API_KEY=
FINDWORK_INTER_REQUEST_DELAY=6.0
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_DAILY_REQUEST_BUDGET=200
JOOBLE_API_KEY=
JOOBLE_INTER_REQUEST_DELAY=1.5
JOOBLE_PAGE_SIZE=50
JOB_DEDUP_ENABLED=true
JOB_DEDUP_LOG_COLLISIONS=true
JOB_PROVIDER_CONTROLS_JSON={"the_muse":{"ingest_enabled":true,"display_enabled":true,"scheduled_enabled":true},"arbeitnow":{"ingest_enabled":true,"display_enabled":true,"scheduled_enabled":true},"findwork":{"ingest_enabled":false,"display_enabled":false,"scheduled_enabled":false},"jooble":{"ingest_enabled":false,"display_enabled":false,"scheduled_enabled":false},"adzuna":{"ingest_enabled":false,"display_enabled":false,"scheduled_enabled":false},"careerjet":{"ingest_enabled":false,"display_enabled":false,"scheduled_enabled":false}}
# Z.AI OCR/LLM key.
ZAI_API_KEY=placeholder_prod_zai_api_key
# Google OAuth credentials.
GOOGLE_CLIENT_ID=placeholder_prod_google_client_id
GOOGLE_CLIENT_SECRET=placeholder_prod_google_client_secret
JOB_SYNC_ENABLED=true
JOB_SYNC_STALE_THRESHOLD_HOURS=6
JOB_SYNC_SOFT_DELETE_MISSES=3
JOB_SYNC_HARD_PURGE_DAYS=180
JOB_SYNC_DISPATCH_INTERVAL_SECONDS=300
JOB_SYNC_CLEANUP_INTERVAL_SECONDS=3600
JOB_SYNC_LOCK_TTL_SECONDS=900
JOB_SYNC_CLEANUP_LOCK_TTL_SECONDS=1800
JOB_LINK_RECHECK_HOURS=168
JOB_LINK_BACKFILL_BATCH_SIZE=25
JOB_LINK_BACKFILL_INTERVAL_SECONDS=1800
JOB_COUNTRY_BACKFILL_BATCH_SIZE=500
JOB_COUNTRY_BACKFILL_INTERVAL_SECONDS=86400
JOB_STALE_AUDIT_AGE_DAYS=45
JOB_STALE_AUDIT_ESCALATION_DAYS=90
# Trim listings from search if they are older than this many days and have not substantively changed.
JOB_STALE_MAX_UNCHANGED_DAYS=365
JOB_STALE_AUDIT_BATCH_SIZE=25
JOB_STALE_AUDIT_INTERVAL_SECONDS=21600
JOB_STALE_AUDIT_RECHECK_HOURS=24
JOB_SYNC_CATEGORY_SCHEDULE_JSON=
JOB_SYNC_ENABLED_PROVIDERS_JSON=["the_muse","arbeitnow"]
