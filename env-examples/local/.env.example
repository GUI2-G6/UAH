# ===================================================================
# UAH local environment template (host development)
# ===================================================================
# Purpose:
# - Run local-only workflows from docker-compose.local.yml and local Vite dev server.
# - Keep everything bound to loopback and isolated from shared dev/beta/prod stacks.
#
# Typical usage:
# - Backend profile: docker compose -f docker-compose.local.yml --profile backend up
# - Frontend mock mode: npm run dev
# - Frontend backend passthrough: npm run dev:backend
# ===================================================================

# --- Core identity and runtime mode ---
ENV=local
PROJECT_NAME=UAH
VERSION=0.1.0
# Backend runtime environment slug.
ENVIRONMENT=local
# Compose naming prefix for local resources.
COMPOSE_PROJECT_NAME=uah-local

# --- Local host ports ---
# Host ports used by docker-compose.local.yml (loopback bindings).
LOCAL_DB_HOST_PORT=5432
LOCAL_BACKEND_HOST_PORT=8000

# --- Postgres for local stack ---
POSTGRES_DB=uah_dev
POSTGRES_USER=uah
POSTGRES_PASSWORD=placeholder_local_postgres_password
POSTGRES_PORT=5432
# Local compose service name for DB container.
POSTGRES_HOST=db-local

# --- Required backend secrets ---
# Required even in local mode because backend validates startup secrets.
SECRET_KEY=placeholder_local_secret_key
SESSION_SECRET=placeholder_local_session_secret
GMAIL_TOKEN_ENCRYPTION_KEY=

# --- Local auth/session isolation ---
AUTH_NAMESPACE=local
AUTH_COOKIE_NAME=uah_auth_local
SESSION_COOKIE_NAME=uah_session_local
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_PATH=/
SESSION_COOKIE_HTTPS_ONLY=false

# --- Local security/seed defaults ---
# Keep disabled unless you explicitly need startup admin seeding.
ADMIN_BOOTSTRAP_ENABLED=false
# Optional deterministic local test account seeding.
DEV_AUTH_TEST_ACCOUNT_ENABLED=false
DEV_AUTH_TEST_USERNAME=devtester
DEV_AUTH_TEST_PASSWORD=
DEV_AUTH_TEST_EMAIL=devtester@uah.local
DEV_AUTH_TEST_FIRST_NAME=Dev
DEV_AUTH_TEST_LAST_NAME=Tester
DEV_AUTH_TEST_IS_ADMIN=false
DEV_AUTH_TEST_IS_DEVELOPER=true
# If true, test account password is reset on each startup.
DEV_AUTH_TEST_ROTATE_PASSWORD=true
# If false, password-reset and verification flows stay local/dev behavior.
EMAILS_ENABLED=false
# Frontend URL used in generated links.
PUBLIC_APP_URL=http://localhost:5173

# --- Optional external integrations ---
# Keep empty unless specifically testing each integration path.
MUSE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
ZAI_API_KEY=
# Local LLM pipeline toggle for backend local profile.
USE_LOCAL_PIPELINE=false
# Redis queue disabled by default in local profile.
REDIS_ENABLED=false

# --- Frontend local-mode controls ---
# Mode options:
# - mock: in-browser mock API interception
# - backend: proxy /api calls to VITE_LOCAL_BACKEND_ORIGIN
VITE_LOCAL_MODE=mock
# Backend origin used when VITE_LOCAL_MODE=backend.
VITE_LOCAL_BACKEND_ORIGIN=http://localhost:8000
# Safety flag: keep false to block accidental remote API targets.
VITE_ALLOW_REMOTE_API=false
# If true in mock mode, auto-populate auth state with default local user.
VITE_LOCAL_AUTO_LOGIN=false
# Browser auth namespace for local frontend sessions.
VITE_AUTH_NAMESPACE=local
