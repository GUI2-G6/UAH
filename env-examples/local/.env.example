ENV=local
PROJECT_NAME=UAH
VERSION=0.1.0
ENVIRONMENT=local
COMPOSE_PROJECT_NAME=uah-local

# --- Local host ports (loopback only in docker-compose.local.yml) ---
LOCAL_DB_HOST_PORT=5432
LOCAL_BACKEND_HOST_PORT=8000

# --- Postgres ---
POSTGRES_DB=uah_dev
POSTGRES_USER=uah
POSTGRES_PASSWORD=placeholder_local_postgres_password
POSTGRES_PORT=5432
POSTGRES_HOST=db-local

# --- Required backend secrets ---
SECRET_KEY=placeholder_local_secret_key
SESSION_SECRET=placeholder_local_session_secret

# --- Security defaults for local backend profile ---
ADMIN_BOOTSTRAP_ENABLED=false
EMAILS_ENABLED=false
PUBLIC_APP_URL=http://localhost:5173

# --- Optional integrations (leave empty unless testing integration paths) ---
MUSE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
ZAI_API_KEY=
USE_LOCAL_PIPELINE=false
REDIS_ENABLED=false

# --- Frontend local mode hints ---
# npm run dev           -> mock mode (default)
# npm run dev:backend   -> backend passthrough mode
VITE_LOCAL_MODE=mock
VITE_LOCAL_BACKEND_ORIGIN=http://localhost:8000
VITE_ALLOW_REMOTE_API=false
VITE_LOCAL_AUTO_LOGIN=false
