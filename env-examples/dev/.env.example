# ===================================================================
# UAH dev environment template
# ===================================================================
# How to use:
# 1) Copy this file to repo root as .env for a dev deployment.
# 2) Replace all placeholder_* values with real secrets.
# 3) Keep this file committed as documentation only; do not store real secrets.
#
# Notes:
# - ENV is used by scripts/log labels.
# - ENVIRONMENT is used by backend runtime behavior and safety checks.
# - Use environment-specific namespaces/cookies to avoid cross-env auth bleed.
# ===================================================================

# --- Core identity and runtime mode ---
# Short label used by scripts and logs (dev|beta|prod|local).
ENV=dev
# Human readable service name shown in docs and API metadata.
PROJECT_NAME=UAH
# API version string surfaced by /api/ endpoint.
VERSION=0.1.0
# Canonical backend environment slug (development|beta|production|local).
ENVIRONMENT=development
# Docker Compose project prefix. Controls container/network naming.
COMPOSE_PROJECT_NAME=uah-dev
# JWT access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# If true, ignore on-disk geolocation dataset and use fallback behavior.
GEOLOCATION_IGNORE_LOCAL_DATASET=false

# --- Public URL / hostname ---
# Domain Nginx uses for host routing in this environment.
DEV_DOMAIN=dev.uahapp.com

# --- Postgres database connection ---
# Database name created inside Postgres.
POSTGRES_DB=uah_dev
# DB username used by backend.
POSTGRES_USER=uah
# DB password (required). Must be strong and unique per environment.
POSTGRES_PASSWORD=placeholder_dev_postgres_password
# DB TCP port exposed inside Docker network (usually 5432).
POSTGRES_PORT=5432
# DB host seen by backend container ("db" service name in compose).
POSTGRES_HOST=db

# --- External job search API ---
# Required for job search endpoints backed by Muse API.
MUSE_API_KEY=placeholder_dev_muse_api_key

# --- Google OAuth (user sign-in) ---
# OAuth client credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=placeholder_dev_google_client_id
GOOGLE_CLIENT_SECRET=placeholder_dev_google_client_secret
# Must exactly match an authorized redirect URI in Google Cloud.
GOOGLE_REDIRECT_URI=https://dev.uahapp.com/api/auth/google/callback

# --- Gmail OAuth (optional mailbox integration) ---
# Use same or separate OAuth app as Google sign-in.
GMAIL_CLIENT_ID=placeholder_dev_gmail_client_id
GMAIL_CLIENT_SECRET=placeholder_dev_gmail_client_secret
GMAIL_REDIRECT_URI=https://dev.uahapp.com/api/auth/google/callback

# --- Auth/session security ---
# SECRET_KEY signs JWT access tokens.
SECRET_KEY=placeholder_dev_secret_key
# SESSION_SECRET signs server-side session cookie payloads.
SESSION_SECRET=placeholder_dev_session_secret
# Auth namespace used to isolate tokens/cookies across environments.
# Expected values: dev | beta | prod.
AUTH_NAMESPACE=dev
# Session cookie name. Must be environment-scoped and not "session".
SESSION_COOKIE_NAME=uah_session_dev
# Cookie SameSite policy: lax | strict | none
SESSION_COOKIE_SAMESITE=lax
# Cookie path scope ("/" for whole app).
SESSION_COOKIE_PATH=/
# Set true for HTTPS-only cookies. Required when SameSite=none.
SESSION_COOKIE_HTTPS_ONLY=false

# --- Z.AI OCR + LLM endpoints ---
# API key for Z.AI cloud parsing.
ZAI_API_KEY=placeholder_dev_zai_api_key
# OCR endpoint URL.
ZAI_OCR_URL=https://api.z.ai/api/paas/v4/layout_parsing
# Chat/completions endpoint URL.
ZAI_LLM_URL=https://api.z.ai/api/paas/v4/chat/completions
# Default model for LLM parsing calls.
ZAI_LLM_MODEL=GLM-4.7-Flash

# --- Local Ollama pipeline (feature flag) ---
# If true, backend prefers local Ollama endpoints for legacy LLM parsing paths.
# Resume parse method can still be selected per request in UI.
USE_LOCAL_PIPELINE=false
# Local OCR endpoint URL and model name.
LOCAL_OCR_URL=http://10.8.0.8:11434
LOCAL_OCR_MODEL=glm-ocr-hires
# Local LLM endpoint URL and model name.
LOCAL_LLM_URL=http://10.8.0.8:11434
LOCAL_LLM_MODEL=qwen2.5:7b
# Request timeout seconds for local OCR/LLM calls.
LOCAL_OCR_TIMEOUT=120
LOCAL_LLM_TIMEOUT=120
# DPI used when rasterizing PDFs for OCR.
LOCAL_OCR_DPI=120

# --- Redis parse queue (feature flag) ---
# If false, queue worker is disabled and parse queue endpoints should not be relied on.
REDIS_ENABLED=false
# Host-bound Redis port for dev stack (helps avoid local port collisions).
REDIS_HOST_PORT=6379
# Backend Redis connection URL.
REDIS_URL=redis://uah-redis:6379/0
# Queue key names by method. Keep env-specific prefixes.
PARSE_QUEUE_NAME=uah:parse_jobs
PARSE_QUEUE_NAME_CLOUD=uah:parse_jobs:cloud
PARSE_QUEUE_NAME_LOCAL=uah:parse_jobs:local
PARSE_QUEUE_NAME_RULES=uah:parse_jobs:rules
# Retry policy: -1 means retry indefinitely.
PARSE_QUEUE_MAX_RETRIES=3
PARSE_QUEUE_MAX_RETRIES_CLOUD=-1
PARSE_QUEUE_MAX_RETRIES_LOCAL=-1
# Rules parser is deterministic; default is no retries on rules failures.
PARSE_QUEUE_MAX_RETRIES_RULES=0
# Worker concurrency per method queue.
PARSE_QUEUE_CONCURRENCY_CLOUD=1
PARSE_QUEUE_CONCURRENCY_LOCAL=2
PARSE_QUEUE_CONCURRENCY_RULES=2
# Claim TTL (seconds) before a job is considered stale and recoverable.
PARSE_QUEUE_CLAIM_TTL_SECONDS=1800
# Grace period on shutdown to drain inflight jobs.
PARSE_QUEUE_SHUTDOWN_DRAIN_SECONDS=30
# Stale threshold (minutes) for reconciliation logic.
PARSE_QUEUE_STALE_JOB_MINUTES=20

# --- Admin bootstrap account ---
# If true, backend ensures this admin user exists at startup.
# Keep enabled only when you intentionally manage admin bootstrap via env.
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_USERNAME=adminUAH
ADMIN_BOOTSTRAP_PASSWORD=placeholder_dev_admin_bootstrap_password
ADMIN_BOOTSTRAP_FIRST_NAME=Admin
ADMIN_BOOTSTRAP_LAST_NAME=UAH

# --- Dev test account bootstrap (dev/local only) ---
# Enables deterministic test login account creation on startup.
# Must remain false outside development/local environments.
DEV_AUTH_TEST_ACCOUNT_ENABLED=true
DEV_AUTH_TEST_USERNAME=devtester
DEV_AUTH_TEST_PASSWORD=placeholder_dev_test_account_password
DEV_AUTH_TEST_EMAIL=devtester@uah.local
DEV_AUTH_TEST_FIRST_NAME=Dev
DEV_AUTH_TEST_LAST_NAME=Tester
DEV_AUTH_TEST_IS_ADMIN=false
DEV_AUTH_TEST_IS_DEVELOPER=true
# If true, password is rotated to DEV_AUTH_TEST_PASSWORD on each startup.
DEV_AUTH_TEST_ROTATE_PASSWORD=true

# --- Email delivery (SMTP) ---
# If false, email flows run in dev behavior (token responses/logging).
EMAILS_ENABLED=true
# Public app URL used for links in emails.
PUBLIC_APP_URL=https://uahapp.com
# SMTP relay settings.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM=UAH <noreply@uahapp.com>
# Optional username/password when relay requires auth.
SMTP_USERNAME=
SMTP_PASSWORD=
# Socket timeout for SMTP operations.
SMTP_TIMEOUT_SECONDS=20

# --- Geolocation providers ---
# Provider options currently supported: ipapi | ipstack
GEO_IP_PROVIDER=ipapi
# ipapi: no key required; quick to start.
# ipstack: requires key; configure if GEO_IP_PROVIDER=ipstack.
IPSTACK_API_KEY=placeholder_dev_ipstack_api_key
# If true, build and cache city dataset at startup.
GEOLOCATION_AUTO_BUILD_DATASET=true
# Max wait (seconds) for startup dataset build.
GEOLOCATION_DATASET_TIMEOUT_SECONDS=90
# Contact string for Nominatim usage.
NOMINATIM_USER_AGENT=UAH-JobBoard-Geolocation/1.0

# --- Muse search guardrails and caching ---
# Page chase controls request breadth and cost.
MUSE_PAGE_CHASE_ENABLED=true
MUSE_PAGE_CHASE_MAX_PAGES=5
MUSE_PAGE_CHASE_MAX_API_CALLS_PER_REQUEST=5
MUSE_PAGE_CHASE_TARGET_ACCEPTED_RESULTS=20
MUSE_PAGE_CHASE_MIN_FILTERED_RATIO=0.25
MUSE_PAGE_CHASE_TIMEOUT_SECONDS=12
# Max number of location params passed to Muse.
MUSE_LOCATION_PARAM_CAP=60
# Default API response page size for job listings.
JOBS_DEFAULT_PAGE_SIZE=10
# In-memory jobs cache controls.
JOBS_CACHE_ENABLED=true
JOBS_CACHE_TTL_SECONDS=45
JOBS_CACHE_MAX_KEYS=250
# Muse landing URL validation controls.
JOBS_URL_VALIDATION_ENABLED=true
JOBS_URL_VALIDATION_TIMEOUT_SECONDS=2.5
JOBS_URL_VALIDATION_MAX_CHECKS_PER_REQUEST=20
JOBS_URL_VALIDATION_CONCURRENCY=4
JOBS_URL_VALIDATION_BAD_TTL_SECONDS=1800
JOBS_URL_VALIDATION_GOOD_TTL_SECONDS=300
JOBS_URL_VALIDATION_UNKNOWN_TTL_SECONDS=90
# Adaptive chase can widen search when results are sparse.
MUSE_ADAPTIVE_PAGE_CHASE_ENABLED=true
MUSE_ADAPTIVE_PAGE_CHASE_EXTRA_PAGES=2
MUSE_ADAPTIVE_PAGE_CHASE_BREADTH_THRESHOLD=45
MUSE_ADAPTIVE_PAGE_CHASE_MIN_FILTERED_RATIO=0.2
# Constraint compatibility filter behavior.
CONSTRAINT_FILTER_MIN_CONFIDENCE=high
CONSTRAINT_COMPATIBILITY_ENABLED=true
# Muse-supported location index refresh behavior.
MUSE_LOCATION_INDEX_ENABLED=true
MUSE_LOCATION_INDEX_REFRESH_HOURS=24
MUSE_LOCATION_INDEX_SCAN_MAX_PAGES=25
MUSE_LOCATION_INDEX_TIMEOUT_SECONDS=10
MUSE_LOCATION_INDEX_RETENTION_DAYS=45

# --- TLS settings for frontend container ---
# Dev stack commonly serves behind VPN with cert mounted from host.
DEV_TLS_ENABLED=true
DEV_TLS_CERT_PATH=/etc/nginx/certs/tls.crt
DEV_TLS_KEY_PATH=/etc/nginx/certs/tls.key

# --- Frontend build/runtime auth behavior ---
# Vite namespace for browser localStorage auth keys.
VITE_AUTH_NAMESPACE=dev
# Frontend local mode: backend | mock
# Remote environments should use backend.
VITE_LOCAL_MODE=backend
