# ===================================================================
# UAH beta environment template
# ===================================================================
# How to use:
# 1) Copy to repo root as .env on the beta deployment host.
# 2) Replace every placeholder_* value with real beta credentials/secrets.
# 3) Keep beta namespaces, cookie names, queue names, and compose project
#    names distinct from dev to prevent cross-environment contamination.
# ===================================================================

# --- Core identity and runtime mode ---
# Short environment label used by scripts and logging.
ENV=beta
# API metadata fields.
PROJECT_NAME=UAH
VERSION=0.1.0
# Canonical backend environment slug.
ENVIRONMENT=beta
# Compose project prefix; keeps beta container names isolated.
COMPOSE_PROJECT_NAME=uah-beta
# JWT access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# If true, ignore local geolocation dataset cache at startup.
GEOLOCATION_IGNORE_LOCAL_DATASET=false

# --- Public URL / hostname ---
# Beta domain expected by frontend and Nginx host matching.
DEV_DOMAIN=beta.uahapp.com

# --- Postgres database connection ---
# Beta must use its own DB/schema and credentials.
POSTGRES_DB=uah_beta
POSTGRES_USER=uah
POSTGRES_PASSWORD=placeholder_beta_postgres_password
POSTGRES_PORT=5432
# Docker service hostname seen by backend.
POSTGRES_HOST=db

# --- External job search API ---
MUSE_API_KEY=placeholder_beta_muse_api_key

# --- Google OAuth (user sign-in) ---
GOOGLE_CLIENT_ID=placeholder_beta_google_client_id
GOOGLE_CLIENT_SECRET=placeholder_beta_google_client_secret
# Must be registered in Google Cloud OAuth redirect list.
GOOGLE_REDIRECT_URI=https://beta.uahapp.com/api/auth/google/callback

# --- Gmail OAuth (optional mailbox integration) ---
GMAIL_CLIENT_ID=placeholder_beta_gmail_client_id
GMAIL_CLIENT_SECRET=placeholder_beta_gmail_client_secret
GMAIL_REDIRECT_URI=https://beta.uahapp.com/api/auth/google/callback

# --- Auth/session security ---
# Token/session signing secrets. Must be unique vs dev/prod.
SECRET_KEY=placeholder_beta_secret_key
SESSION_SECRET=placeholder_beta_session_secret
# Namespace and cookie names MUST stay beta-specific.
AUTH_NAMESPACE=beta
SESSION_COOKIE_NAME=uah_session_beta
# SameSite options: lax | strict | none
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_PATH=/
# Set true when enforcing HTTPS-only cookie transport.
SESSION_COOKIE_HTTPS_ONLY=false

# --- Z.AI OCR + LLM endpoints ---
ZAI_API_KEY=placeholder_beta_zai_api_key
ZAI_OCR_URL=https://api.z.ai/api/paas/v4/layout_parsing
ZAI_LLM_URL=https://api.z.ai/api/paas/v4/chat/completions
ZAI_LLM_MODEL=GLM-4.7-Flash

# --- Local Ollama pipeline (feature flag) ---
# Parse method is selected per request in UI (cloud/local/rules).
# USE_LOCAL_PIPELINE controls legacy llm fallback path only.
USE_LOCAL_PIPELINE=false
LOCAL_OCR_URL=http://10.8.0.8:11434
LOCAL_OCR_MODEL=glm-ocr-hires
LOCAL_LLM_URL=http://10.8.0.8:11434
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_OCR_TIMEOUT=120
LOCAL_LLM_TIMEOUT=120
LOCAL_OCR_DPI=120

# --- Redis parse queue and isolation ---
# Enable background queue workers and queue-backed parse orchestration.
REDIS_ENABLED=false
# Backend runtime Redis URL.
REDIS_URL=redis://uah-beta-redis:6379/0
# Queue keys should stay beta-prefixed to avoid collisions with dev.
PARSE_QUEUE_NAME=uah:beta:parse_jobs
PARSE_QUEUE_NAME_CLOUD=uah:beta:parse_jobs:cloud
PARSE_QUEUE_NAME_LOCAL=uah:beta:parse_jobs:local
PARSE_QUEUE_NAME_RULES=uah:beta:parse_jobs:rules
# Host port mapped for beta Redis when dev+beta share a host.
BETA_REDIS_HOST_PORT=6380
# Beta override vars consumed by docker-compose.beta.yml.
BETA_REDIS_URL=redis://uah-beta-redis:6379/0
BETA_PARSE_QUEUE_NAME=uah:beta:parse_jobs
BETA_PARSE_QUEUE_NAME_CLOUD=uah:beta:parse_jobs:cloud
BETA_PARSE_QUEUE_NAME_LOCAL=uah:beta:parse_jobs:local
BETA_PARSE_QUEUE_NAME_RULES=uah:beta:parse_jobs:rules
# Retry policy and worker concurrency.
PARSE_QUEUE_MAX_RETRIES=3
PARSE_QUEUE_MAX_RETRIES_CLOUD=-1
PARSE_QUEUE_MAX_RETRIES_LOCAL=-1
PARSE_QUEUE_MAX_RETRIES_RULES=0
PARSE_QUEUE_CONCURRENCY_CLOUD=1
PARSE_QUEUE_CONCURRENCY_LOCAL=2
PARSE_QUEUE_CONCURRENCY_RULES=2
# Queue claim/cleanup controls.
PARSE_QUEUE_CLAIM_TTL_SECONDS=1800
PARSE_QUEUE_SHUTDOWN_DRAIN_SECONDS=30
PARSE_QUEUE_STALE_JOB_MINUTES=20

# --- Admin bootstrap account ---
# If true, backend ensures this admin exists on startup.
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_USERNAME=adminUAH
ADMIN_BOOTSTRAP_PASSWORD=placeholder_beta_admin_bootstrap_password
ADMIN_BOOTSTRAP_FIRST_NAME=Admin
ADMIN_BOOTSTRAP_LAST_NAME=UAH

# --- Dev test account controls (must stay disabled in beta) ---
# Keys are retained for template parity with dev/local.
DEV_AUTH_TEST_ACCOUNT_ENABLED=false
DEV_AUTH_TEST_USERNAME=
DEV_AUTH_TEST_PASSWORD=
DEV_AUTH_TEST_EMAIL=
DEV_AUTH_TEST_FIRST_NAME=
DEV_AUTH_TEST_LAST_NAME=
DEV_AUTH_TEST_IS_ADMIN=
DEV_AUTH_TEST_ROTATE_PASSWORD=

# --- Email delivery (SMTP) ---
EMAILS_ENABLED=true
PUBLIC_APP_URL=https://uahapp.com
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM=UAH <noreply@uahapp.com>
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=20

# --- Geolocation providers ---
# Supported values: ipapi | ipstack
GEO_IP_PROVIDER=ipapi
# ipstack key used only when GEO_IP_PROVIDER=ipstack.
IPSTACK_API_KEY=placeholder_beta_ipstack_api_key
# Startup dataset build behavior.
GEOLOCATION_AUTO_BUILD_DATASET=true
GEOLOCATION_DATASET_TIMEOUT_SECONDS=90
NOMINATIM_USER_AGENT=UAH-JobBoard-Geolocation/1.0

# --- Muse search guardrails ---
MUSE_PAGE_CHASE_ENABLED=true
MUSE_PAGE_CHASE_MAX_PAGES=3
MUSE_PAGE_CHASE_MAX_API_CALLS_PER_REQUEST=3
MUSE_PAGE_CHASE_TARGET_ACCEPTED_RESULTS=20
MUSE_PAGE_CHASE_MIN_FILTERED_RATIO=0.4
MUSE_PAGE_CHASE_TIMEOUT_SECONDS=8
MUSE_LOCATION_PARAM_CAP=60
JOBS_DEFAULT_PAGE_SIZE=10
JOBS_CACHE_ENABLED=true
JOBS_CACHE_TTL_SECONDS=45
JOBS_CACHE_MAX_KEYS=250
MUSE_ADAPTIVE_PAGE_CHASE_ENABLED=true
MUSE_ADAPTIVE_PAGE_CHASE_EXTRA_PAGES=2
MUSE_ADAPTIVE_PAGE_CHASE_BREADTH_THRESHOLD=45
MUSE_ADAPTIVE_PAGE_CHASE_MIN_FILTERED_RATIO=0.2
CONSTRAINT_FILTER_MIN_CONFIDENCE=high
CONSTRAINT_COMPATIBILITY_ENABLED=true
MUSE_LOCATION_INDEX_ENABLED=true
MUSE_LOCATION_INDEX_REFRESH_HOURS=24
MUSE_LOCATION_INDEX_SCAN_MAX_PAGES=25
MUSE_LOCATION_INDEX_TIMEOUT_SECONDS=10
MUSE_LOCATION_INDEX_RETENTION_DAYS=45

# --- TLS inside frontend container ---
# Cloudflare tunnel commonly terminates TLS, so beta can run HTTP internally.
DEV_TLS_ENABLED=false
DEV_TLS_CERT_PATH=/etc/nginx/certs/tls.crt
DEV_TLS_KEY_PATH=/etc/nginx/certs/tls.key

# --- Cloudflare tunnel ---
# Token that allows cloudflared container to join configured tunnel.
CLOUDFLARE_BETA_TUNNEL_TOKEN=placeholder_beta_cloudflare_tunnel_token

# --- Frontend build/runtime auth behavior ---
# Browser localStorage auth namespace for beta frontend build.
VITE_AUTH_NAMESPACE=beta
# Remote stacks should run in backend mode, not mock mode.
VITE_LOCAL_MODE=backend
