# ============================================================
# UAH — Root .gitignore
# ============================================================

# ----- Environment / Secrets -----
.env
.env.*
!env-examples/**/.env.example
!frontend/.env.local.example
!uah-browser-extension/.env.local.example
!uah-browser-extension/.env.example

# ----- Docker volumes (database data, etc.) -----
volumes/
logs/

# ----- OS files -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Editor / IDE -----
.idea/
*.swp
*.swo
*~
.vscode/
.worktrees/

# ----- Python / Backend -----
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.pytest_cache/
*.sqlite3
backend/data/cities.json

# ----- Node / Frontend -----
node_modules/
dist/
dist-ssr/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Temporary files -----
test.txt
NETWORK_FINDINGS_2026-04-08.md
endpoint_inventory_backend.tsv
endpoint_inventory_frontend_calls.tsv
endpoint_utilization_matrix_2026-04-11.tsv
/docs/backend/*.tsv
/frontend/node_modules/.vite/deps
backend/app/scrapers/checklist/checklist_log/*
!backend/app/scrapers/checklist/checklist_log/.gitkeep
mobile-friendliness-audit-2026-04-22.md

# Ops runtime state (generated from scripts/uah.sh)
.ops-state/
landing/public/downloads/uah-browser-extension-alpha.last-repacked.txt

# Celery Beat runtime scheduler file
celerybeat-schedule
celerybeat.pid
/.audit-venv
hw1needfinding.md
hw2proposal.md
hw3slides.md
HW5Alpha.md
hw6usabilityanalysis.md
hw7.md
HW7tasklist.md
HW7PresentationGuide.md
