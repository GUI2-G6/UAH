# ============================================================
# UAH — Root .gitignore
# ============================================================

# ----- Environment / Secrets -----
.env
.env.*
!env-examples/**/.env.example

# ----- Docker volumes (database data, etc.) -----
volumes/
logs/

# ----- OS files -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Editor / IDE -----
.idea/
*.swp
*.swo
*~
.vscode/

# ----- Python / Backend -----
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.pytest_cache/
*.sqlite3
backend/data/cities.json

# ----- Node / Frontend -----
node_modules/
dist/
dist-ssr/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Temporary files -----
test.txt
NETWORK_FINDINGS_2026-04-08.md
endpoint_inventory_backend.tsv
endpoint_inventory_frontend_calls.tsv
endpoint_utilization_matrix_2026-04-11.tsv
/docs/backend/*.tsv
/frontend/node_modules/.vite/deps

# Celery Beat runtime scheduler file
celerybeat-schedule
celerybeat.pid
