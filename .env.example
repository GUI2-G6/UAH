# ============================================================
# UAH — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================

# ----- PostgreSQL -----
POSTGRES_USER=uah
POSTGRES_PASSWORD=          # REQUIRED — set a strong password
POSTGRES_DB=uah_dev
POSTGRES_PORT=5432

# ----- Docker Compose -----
COMPOSE_PROJECT_NAME=uah-dev
ENV=dev
DEV_DOMAIN=dev.uahapp.com
