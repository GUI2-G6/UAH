COMPOSE_PROJECT_NAME=uah-dev
PROJECT_NAME=UAH
VERSION=0.1.0
# ENV controls Docker Compose profile selection (dev / beta / prod)
ENV=dev
# ENVIRONMENT controls runtime behavior (development / production)
# In production: API docs are disabled, debug info is hidden
ENVIRONMENT=development
# Public-facing domain for Nginx and CORS
DEV_DOMAIN=dev.uahapp.com

# --- Postgres ---
POSTGRES_USER=uah
# Required. Use a strong random password (e.g. openssl rand -hex 16)
POSTGRES_PASSWORD=
POSTGRES_DB=uah_dev
# "db" matches the Docker Compose service name. Use "localhost" for local dev without Docker.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Security ---
# Required. Used to sign JWTs and verification tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Required. Used for session middleware (Google OAuth state cookies).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# How long login tokens last before the user has to re-authenticate
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- API ---
API_PORT=8000
API_HOST=0.0.0.0

# --- Vue ---
VUE_PORT=5173

# --- The Muse Jobs API ---
# Free tier key from https://www.themuse.com/developers — used for job board search
MUSE_API_KEY=

# --- Google OAuth (Login with Google) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://dev.uahapp.com/api/auth/google/callback

# --- Gmail Integration (Application Status Scanning) ---
# Separate from login OAuth. Uses gmail.readonly scope to scan inbox.
# Can reuse the same Google Cloud project but needs gmail.readonly enabled.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://dev.uahapp.com/api/integrations/gmail/callback

# --- Z.AI (Resume OCR + LLM Parsing) ---
# API key from https://z.ai — powers PDF-to-text extraction and LLM resume parsing
ZAI_API_KEY=
# Default URLs and model. Only change if Z.AI updates their API.
ZAI_OCR_URL=https://api.z.ai/api/paas/v4/layout_parsing
ZAI_LLM_URL=https://api.z.ai/api/paas/v4/chat/completions
ZAI_LLM_MODEL=GLM-4.7-Flash

# --- Email (SMTP) ---
# Set EMAILS_ENABLED=true to send real emails. When false, endpoints return dev tokens instead.
EMAILS_ENABLED=false
# Base URL for links in emails (password reset, email verification)
PUBLIC_APP_URL=https://dev.uahapp.com
# SMTP server settings. For Gmail: smtp.gmail.com / 587 / TLS
# For AWS SES: email-smtp.<region>.amazonaws.com / 587 / TLS
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Display name and address for outgoing emails
SMTP_FROM=UAH <noreply@uahapp.com>
# SMTP auth credentials (for Gmail use an App Password, not your account password)
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=20

# --- Geolocation ---
# Provider for IP-to-location. Options: ipapi (free, no key), ipstack (needs key)
GEO_IP_PROVIDER=ipapi
# Only needed when GEO_IP_PROVIDER=ipstack
IPSTACK_API_KEY=
GEOLOCATION_AUTO_BUILD_DATASET=true
GEOLOCATION_IGNORE_LOCAL_DATASET=false
GEOLOCATION_DATASET_TIMEOUT_SECONDS=90
NOMINATIM_USER_AGENT=UAH-JobBoard-Geolocation/1.0

# --- Muse search guardrails ---
# Controls how aggressively the job search paginates through Muse API results.
# Defaults are tuned for a good balance of speed and coverage. Increase MAX_PAGES
# or TARGET_ACCEPTED_RESULTS for broader searches at the cost of latency.
MUSE_PAGE_CHASE_ENABLED=true
MUSE_PAGE_CHASE_MAX_PAGES=3
MUSE_PAGE_CHASE_MAX_API_CALLS_PER_REQUEST=3
MUSE_PAGE_CHASE_TARGET_ACCEPTED_RESULTS=20
MUSE_PAGE_CHASE_MIN_FILTERED_RATIO=0.4
MUSE_PAGE_CHASE_TIMEOUT_SECONDS=8
MUSE_ADAPTIVE_PAGE_CHASE_ENABLED=true
MUSE_ADAPTIVE_PAGE_CHASE_EXTRA_PAGES=2
MUSE_ADAPTIVE_PAGE_CHASE_BREADTH_THRESHOLD=45
MUSE_ADAPTIVE_PAGE_CHASE_MIN_FILTERED_RATIO=0.2
MUSE_LOCATION_PARAM_CAP=60
CONSTRAINT_FILTER_MIN_CONFIDENCE=high
CONSTRAINT_COMPATIBILITY_ENABLED=true
JOBS_DEFAULT_PAGE_SIZE=10
JOBS_CACHE_ENABLED=true
JOBS_CACHE_TTL_SECONDS=45
JOBS_CACHE_MAX_KEYS=250

# --- Muse location index (country selector source) ---
# Background task that scans Muse API for available job locations per country.
MUSE_LOCATION_INDEX_ENABLED=true
MUSE_LOCATION_INDEX_REFRESH_HOURS=24
MUSE_LOCATION_INDEX_SCAN_MAX_PAGES=25
MUSE_LOCATION_INDEX_TIMEOUT_SECONDS=10
MUSE_LOCATION_INDEX_RETENTION_DAYS=45

# --- Dev TLS (VPN-only HTTPS) ---
# Enable if running HTTPS locally through Nginx with self-signed certs
DEV_TLS_ENABLED=false
DEV_TLS_CERT_PATH=/etc/nginx/certs/tls.crt
DEV_TLS_KEY_PATH=/etc/nginx/certs/tls.key

# --- Admin ---
# Set ADMIN_BOOTSTRAP_ENABLED=true to auto-create an admin account on startup.
# The admin account uses admincontact@uahapp.com as the email.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FIRST_NAME=
ADMIN_BOOTSTRAP_LAST_NAME=
